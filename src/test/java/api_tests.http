### to get all patients
GET http://localhost:8080/api/patients
Accept: application/json


### to delete a patient
DELETE http://localhost:8080/api/patients/P001
//after running, run previous one and youll see that patient
//with this id is deleted.

### to search for a hospital
GET http://localhost:8080/api/hospitals?search=uptown
Accept: application/json


### to add patient
POST http://localhost:8080/api/patients
Accept: application/json
Content-Type:application/json

{
  "firstName": "Rick",
  "lastName": "Doe",
  "age": 20,
  "gender": "MALE",
  "admissionDate": "2025-02-05",
  "billingAmount": 5000.0
}
